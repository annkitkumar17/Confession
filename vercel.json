{
  "version": 2,
  "cleanUrls": true,
  "framework": null,
  "routes": [
    {
      "src": "/style.css",
      "headers": { "content-type": "text/css; charset=utf-8" },
      "dest": "/style.css"
    },
    {
      "src": "/script.js",
      "headers": { "content-type": "application/javascript; charset=utf-8" },
      "dest": "/script.js"
    },
    {
      "src": "/config.js",
      "headers": { "content-type": "application/javascript; charset=utf-8" },
      "dest": "/config.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
